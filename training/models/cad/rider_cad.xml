    <position name="leg12" joint="extension12" kp="1200" kv="5" ctrlrange="-.018 .018" forcerange="-15 15" />
    <position name="leg22" joint="extension22" kp="1200" kv="5" ctrlrange="-.018 .018" forcerange="-15 15" />
