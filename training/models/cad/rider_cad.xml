      <inertial pos=".001 0 -.006" mass=".42" diaginertia=".000269 .000371 .000465" />
      <geom name="chassis" type="box" size=".045 .036 .025" material="shell" rgba="0 0 0 0" />
      <site name="imu" pos="0 0 -.005" size=".002" />
      <camera name="follow" mode="trackcom" pos=".42 -.48 .26" xyaxes=".75 .66 0 -.24 .28 .93" />
      <body name="leg12" pos="0 .0433 -.081">
        <joint name="extension12" type="slide" axis="0 0 -1" range="-.018 .018" damping="1" armature=".0001" />
        <inertial pos="0 0 .028" mass=".025" diaginertia=".00001 .00001 .000001" />
        <body name="wheel11">
          <joint name="wheel11" type="hinge" axis="0 1 0" frictionloss=".00005" />
          <inertial pos="0 0 0" mass=".045" diaginertia=".0000116 .00002134 .0000116" />
          <geom name="tyre11" type="cylinder" size=".0308 .00785" zaxis="0 1 0" material="tyre" rgba="0 0 0 0" />
          <geom name="cad_wheel11" type="mesh" mesh="cad_wheel11" contype="0" conaffinity="0" group="2" material="tyre" />
        </body>
        <geom name="cad_leg12" type="mesh" mesh="cad_leg12" contype="0" conaffinity="0" group="2" material="cad_shell" />
      </body>
      <body name="leg22" pos="0 -.0433 -.081">
        <joint name="extension22" type="slide" axis="0 0 -1" range="-.018 .018" damping="1" armature=".0001" />
        <inertial pos="0 0 .028" mass=".025" diaginertia=".00001 .00001 .000001" />
