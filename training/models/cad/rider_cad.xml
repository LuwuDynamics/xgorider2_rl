<mujoco model="Rider2 equivalent wheel-leg model">
  <compiler angle="radian" autolimits="true" />
  <option timestep="0.002" integrator="implicitfast" solver="Newton" iterations="20" gravity="0 0 -9.81" />
  <visual>
    <global offwidth="1280" offheight="720" />
    <quality shadowsize="2048" />
    <headlight ambient=".4 .4 .4" />
  </visual>
  <default>
    <geom contype="1" conaffinity="2" friction=".9 .005 .0001" condim="3" solref=".008 1" solimp=".9 .95 .001" />
    <joint damping="0.0001" armature="0.000003" />
    <default class="visual">
      <geom contype="0" conaffinity="0" group="2" />
    </default>
  </default>
  <asset>
    <texture name="floor" type="2d" builtin="checker" rgb1=".84 .86 .88" rgb2=".72 .75 .78" width="256" height="256" />
    <material name="floor" texture="floor" texrepeat="12 12" reflectance=".08" />
    <material name="shell" rgba=".16 .20 .24 1" />
    <material name="panel" rgba=".92 .94 .95 1" />
    <material name="tyre" rgba=".045 .05 .055 1" />
    <material name="metal" rgba=".42 .46 .50 1" />
    <material name="cad_shell" rgba=".58 .62 .68 1" specular=".25" shininess=".35" />
